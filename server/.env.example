# TRALIX backend — environment
# Copy to .env (Node) or set as worker secrets (Cloudflare). Never commit real keys.

# Optional: only needed for live model replies. Omit it for Demo Mode.
# It lives on the server and is never exposed to the frontend.
OPENAI_API_KEY=sk-your-key-here

# Optional: override which provider model each TRALIX tier resolves to.
TRALIX_MODEL_FAST=gpt-5-mini
TRALIX_MODEL_SMART=gpt-5
TRALIX_MODEL_CODE=gpt-5-codex
TRALIX_MODEL_RESEARCH=gpt-5

# Optional: only allow your deployed frontend origins (comma separated).
# For a separate API, lock this to the frontend origin; same-origin Render
# frontend/API requests do not require a CORS exception.
TRALIX_ALLOWED_ORIGINS=*

# Optional: enable the OpenAI web search tool for /api/chat.
# TRALIX_ENABLE_WEB_SEARCH=false

# Optional: route through a gateway/proxy instead of api.openai.com.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Keep backend.json url empty when the app and API share the Render origin.
# Only set its public URL when hosting the frontend and API separately; never a key.

# Node adapter only
PORT=8787
