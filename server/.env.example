# ============================================================================
# JARVIS STUDIO — backend environment
#
# Copy this file to server/.env (or ./.env) and fill in what you have.
# NEVER commit the real file: .env is git-ignored on purpose.
#
# You do NOT need every provider. The app works with one working key.
# ============================================================================

# ---------------------------------------------------------------------------
# Free-tier providers — recommended: configure at least one
# ---------------------------------------------------------------------------

# Google Gemini. Free tier, generous.  https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Groq. Free tier, very fast.  https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here

# OpenRouter. Many free models (tagged ":free").  https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key-here

# ---------------------------------------------------------------------------
# Paid providers — used only when you explicitly authorise paid usage
# ---------------------------------------------------------------------------

# OpenAI. Also powers the legacy /api/chat endpoint.
OPENAI_API_KEY=sk-your-key-here

# Anthropic (Claude).
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Mistral (paid; a limited free "experimental" tier exists on some accounts).
# MISTRAL_API_KEY=your-mistral-key-here

# Optional per-provider endpoint overrides (gateways, proxies, local runtimes).
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# ---------------------------------------------------------------------------
# Cost protection — read this before enabling anything paid
# ---------------------------------------------------------------------------

# Free-first routing is always the default. Paid providers are NEVER used
# unless you authorise it here or in Settings → AI Models.
JARVIS_PAID_FALLBACK=false

# Ceiling for paid usage, in US dollars, per calendar month.
# Required before paid fallback can be switched on.
# Only spend we can substantiate from provider-published prices is counted.
JARVIS_MONTHLY_LIMIT_USD=5

# ---------------------------------------------------------------------------
# GitHub — needed for Projects, code tasks, branches and pull requests
# ---------------------------------------------------------------------------

# Simplest option: a fine-grained personal access token, limited to the
# repositories you will use, with:
#   Contents: Read and write
#   Metadata: Read-only
#   Pull requests: Read and write
GITHUB_TOKEN=github_pat_your_token_here

# Narrower alternative: a GitHub App (short-lived installation tokens).
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY="<paste the GitHub App .pem contents here, newlines written as \n>"
# GITHUB_INSTALLATION_ID=12345678

# Per-user browser sign-in (optional; needs a callback URL).
# GITHUB_OAUTH_CLIENT_ID=Iv1.your-client-id
# GITHUB_OAUTH_CLIENT_SECRET=your-client-secret
# GITHUB_OAUTH_REDIRECT_URI=https://your-backend.example/api/v2/github/oauth/callback

# ---------------------------------------------------------------------------
# Voice — text-to-speech only (speech recognition stays in the browser)
# ---------------------------------------------------------------------------

FISH_AUDIO_API_KEY=your-fish-audio-key-here
# FISH_AUDIO_MODEL=s2-pro
# FISH_AUDIO_REFERENCE_ID=your-voice-model-id
# FISH_AUDIO_BASE_URL=https://api.fish.audio/v1/tts   (only for a proxy or a self-hosted gateway)

# ---------------------------------------------------------------------------
# Security, storage and the execution sandbox
# ---------------------------------------------------------------------------

# Shared secret required for every mutating API call (writes, tasks, keys).
# Leave empty for a local single-user instance.
JARVIS_WRITE_TOKEN=set-a-long-random-value-here

# Where settings, task history and stored keys live. Git-ignored.
JARVIS_DATA_DIR=./data

# Sandbox driver: "process" (allowlist + limits) or "docker" (real isolation).
JARVIS_SANDBOX_DRIVER=process

# Network access inside the sandbox. "off" by default; "on" only for projects
# whose tests must install dependencies.
JARVIS_SANDBOX_NETWORK=off

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------

# Comma-separated CORS allow-list. Lock this to your frontend origin.
TRALIX_ALLOWED_ORIGINS=*

# Optional: the OpenAI web-search tool on the legacy /api/chat endpoint.
TRALIX_ENABLE_WEB_SEARCH=false

# Optional overrides for the legacy tier → model mapping.
# TRALIX_MODEL_FAST=gpt-5-mini
# TRALIX_MODEL_SMART=gpt-5
# TRALIX_MODEL_CODE=gpt-5-codex
# TRALIX_MODEL_RESEARCH=gpt-5

# Node adapter only
PORT=8787
