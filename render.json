{
  "name": "tralix-backend",
  "description": "JARVIS frontend and same-origin API on the existing Render service",
  "repository": "https://github.com/tralix-scokt/Ai",
  "rootDirectory": ".",
  "startCommand": "node server/node.js --static",
  "healthCheckPath": "/api/health",
  "env": {
    "NODE_VERSION": {
      "value": "20",
      "sync": false
    },
    "OPENAI_API_KEY": {
      "description": "Optional OpenAI API key for live model replies (server only, never committed); omit for Demo Mode",
      "sync": false
    },
    "TRALIX_ALLOWED_ORIGINS": {
      "value": "https://tralix-backend.onrender.com",
      "sync": false
    },
    "TRALIX_ENABLE_WEB_SEARCH": {
      "value": "false",
      "sync": false
    }
  },
  "domains": [
    {
      "name": ""
    }
  ],
  "numInstances": 1,
  "plan": "free",
  "region": "oregon"
}
